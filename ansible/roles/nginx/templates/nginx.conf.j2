server {
    listen 0.0.0.0:80;
    server_name _;

    access_log /var/log/nginx/mywebapp.access.log;
    error_log  /var/log/nginx/mywebapp.error.log;

    location = / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host        $host;
        proxy_set_header X-Real-IP   $remote_addr;
    }

    location /tasks {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host        $host;
        proxy_set_header X-Real-IP   $remote_addr;
    }

    location /health {
        allow 127.0.0.1;
        deny all;

        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host        $host;
        proxy_set_header X-Real-IP   $remote_addr;
    }
}
